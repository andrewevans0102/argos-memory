# Sender email for Daily Digest briefings (must be a domain verified in Resend, or onboarding@resend.dev for test)
DIGEST_SENDER_EMAIL=Argos <onboarding@resend.dev>

# Set GEMINI_API_KEY and RESEND_API_KEY with `firebase functions:secrets:set`
# (add `--local` when using the Firebase emulators).

# Optional: comma-separated list of allowed user emails to restrict access
# ALLOWED_EMAILS=user@example.com,friend@example.com

# Optional: Gemini model override (defaults to gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: Cloud Scheduler cron schedule (defaults to 0 6 * * * = 6:00 AM daily)
# DIGEST_CRON_SCHEDULE=0 6 * * *

# Optional: Timezone for scheduler execution (defaults to UTC)
# DIGEST_TIMEZONE=UTC
