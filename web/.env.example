# Firebase Web Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: comma-separated list of allowed emails for registration whitelist
# VITE_ALLOWED_EMAILS=user@example.com,friend@example.com

# Optional: connect to local Firebase Emulators (Auth: 9099, Firestore: 8080, Storage: 9199, Functions: 5001)
# VITE_USE_FIREBASE_EMULATORS=true
